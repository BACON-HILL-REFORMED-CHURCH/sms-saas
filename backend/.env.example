# ============================================================
# Backend environment variables — copy to .env and fill in
# ============================================================

# App
NODE_ENV=development
PORT=3001

# PostgreSQL (via Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sms_saas?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (SMTP — use Mailgun/Resend/etc in production)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sms-saas.com

# Pricing margin (% added on top of provider price)
DEFAULT_MARGIN_PERCENT=30

# Providers API keys (add as needed)
PROVIDER_5SIM_API_KEY=
PROVIDER_SMSACTIVATE_API_KEY=
PROVIDER_SMSPOOL_API_KEY=

# Manual recharge payment details (displayed in Telegram Mini App)
PAYMENT_BINANCE_ID=424986517
PAYMENT_USDT_ADDRESS=TBr9rdyfQBeG8zFDCTFeoQqg6VgoDWNKbr
PAYMENT_IBAN=
PAYMENT_CIH_BANK=4011093211021300
